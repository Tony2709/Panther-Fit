# ============================================================
#  CAU HINH MAY CHU CHO HOSTINGER
#  File nay tu dong duoc chep vao thu muc public_html khi deploy.
# ============================================================

# ------------------------------------------------------------
#  1. Trang bao loi
# ------------------------------------------------------------
ErrorDocument 404 /404.html

# ------------------------------------------------------------
#  2. Chuyen huong ve mot dia chi duy nhat
#     Bat https va bo www de Google khong thay hai ban sao.
# ------------------------------------------------------------
<IfModule mod_rewrite.c>
  RewriteEngine On

  # Ep https
  RewriteCond %{HTTPS} !=on
  RewriteCond %{HTTP:X-Forwarded-Proto} !https
  RewriteRule ^(.*)$ https://%{HTTP_HOST}/$1 [R=301,L]

  # Bo www
  RewriteCond %{HTTP_HOST} ^www\.(.+)$ [NC]
  RewriteRule ^(.*)$ https://%1/$1 [R=301,L]

  # Bo duoi .html khi go tay
  RewriteCond %{THE_REQUEST} \s/+(.+?)\.html[\s?] [NC]
  RewriteRule ^ /%1 [R=301,L]

  # Bo dau gach cheo thua o cuoi, tru trang chu
  RewriteCond %{REQUEST_FILENAME} !-d
  RewriteCond %{REQUEST_URI} ^(.+)/$
  RewriteRule ^ %1 [R=301,L]

  # Tra ve dung file tinh ben trong tung thu muc trang
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteCond %{REQUEST_FILENAME} !-d
  RewriteCond %{DOCUMENT_ROOT}/$1/index.html -f
  RewriteRule ^(.*)$ /$1/index.html [L]
</IfModule>

# ------------------------------------------------------------
#  3. Nen file truoc khi gui, trang tai nhanh hon
# ------------------------------------------------------------
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css text/javascript text/plain text/xml
  AddOutputFilterByType DEFLATE application/javascript application/json application/xml
  AddOutputFilterByType DEFLATE image/svg+xml application/rss+xml
</IfModule>

# ------------------------------------------------------------
#  4. Cho trinh duyet giu lai file da tai
#     Anh va font giu mot nam, html khong giu de cap nhat thay ngay.
# ------------------------------------------------------------
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType text/html                 "access plus 0 seconds"
  ExpiresByType text/css                  "access plus 1 year"
  ExpiresByType application/javascript    "access plus 1 year"
  ExpiresByType image/webp                "access plus 1 year"
  ExpiresByType image/avif                "access plus 1 year"
  ExpiresByType image/jpeg                "access plus 1 year"
  ExpiresByType image/png                 "access plus 1 year"
  ExpiresByType image/svg+xml             "access plus 1 year"
  ExpiresByType font/woff2                "access plus 1 year"
  ExpiresByType application/xml           "access plus 1 hour"
</IfModule>

<IfModule mod_headers.c>
  <FilesMatch "\.(css|js|jpg|jpeg|png|webp|avif|svg|woff2)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>

  <FilesMatch "\.html$">
    Header set Cache-Control "public, max-age=0, must-revalidate"
  </FilesMatch>

  # ----------------------------------------------------------
  #  5. Vai lop bao ve co ban
  # ----------------------------------------------------------
  Header always set X-Content-Type-Options "nosniff"
  Header always set X-Frame-Options "SAMEORIGIN"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  Header always set Permissions-Policy "geolocation=(), microphone=(), camera=()"
  Header always set Strict-Transport-Security "max-age=31536000; includeSubDomains"
</IfModule>

# ------------------------------------------------------------
#  6. Chan truy cap file nhat ky va file cau hinh
# ------------------------------------------------------------
<FilesMatch "\.(log|env|json|md|yml|yaml)$">
  Require all denied
</FilesMatch>

# Van cho phep hai file json can thiet cua website
<Files "manifest.webmanifest">
  Require all granted
</Files>

# ------------------------------------------------------------
#  7. Bang ma cho tieng Viet
# ------------------------------------------------------------
AddDefaultCharset UTF-8
