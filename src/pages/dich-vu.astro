---
import { Image } from 'astro:assets';
import Base from '../layouts/Base.astro';
import Icon from '../components/Icon.astro';
import PageHero from '../components/PageHero.astro';
import SectionHeading from '../components/SectionHeading.astro';
import CtaBand from '../components/CtaBand.astro';
import { FIRST_VISIT, SERVICES } from '../data/content.js';

import class01 from '../assets/class-01.jpg';
import class02 from '../assets/class-02.jpg';
import coaching03 from '../assets/coaching-03.jpg';
import coaching05 from '../assets/coaching-05.jpg';
import room03 from '../assets/room-03.jpg';

const serviceImages = {
  'tap-nhom': { main: class01, sub: class02, alt: 'Một lớp tập nhóm tại Panther Fit', altSub: 'Nhóm hội viên đang tập cùng nhau tại Panther Fit' },
  'pt-1-kem-1': { main: coaching03, sub: coaching05, alt: 'Huấn luyện viên kèm riêng một hội viên tại Panther Fit', altSub: 'Huấn luyện viên hướng dẫn động tác cho hội viên tại Panther Fit' },
} as const;
---

<Base
  title="Dịch vụ"
  description="Panther Fit có hai cách tập: lớp tập nhóm có huấn luyện viên dẫn, và PT 1 kèm 1 với bài tập chỉnh riêng theo bạn. Cả hai đều có người đi cùng bạn trên sàn."
>
  <PageHero
    eyebrow="Dịch vụ"
    title="Hai cách tập, cùng một điều kiện là có người đi cùng bạn"
    lede="Ở đây không có gói membership để bạn mua rồi tự bơi. Chọn cách nào thì cũng có huấn luyện viên trên sàn nhìn bạn tập."
    scrim="light"
    image={room03}
    alt="Khu vực tạ đơn và gương lớn tại phòng tập Panther Fit"
  />

  {
    SERVICES.map((service, index) => {
      const images = serviceImages[service.slug as keyof typeof serviceImages];
      const flip = index % 2 === 1;

      return (
        <section
          id={service.slug}
          class:list={['section scroll-mt-24', index % 2 === 1 && 'border-t border-hair bg-night']}
        >
          <div class="shell">
            <div class="grid items-start gap-12 lg:grid-cols-2 lg:gap-20">
              <!-- Cot anh dinh theo man hinh khi cuon, vi cot chu ben canh
                   dai hon nhieu. Neu de anh dung yen thi phan duoi cua
                   section bi trong mot mang lon. -->
              <div
                class:list={[
                  'flex flex-col gap-5 lg:sticky lg:top-28 lg:self-start',
                  flip && 'lg:order-2',
                ]}
              >
                <div class="frame reveal aspect-[4/3]">
                  <Image
                    src={images.main}
                    alt={images.alt}
                    widths={[600, 900, 1400]}
                    sizes="(min-width: 1024px) 46vw, 92vw"
                    class="img-cover"
                    loading="lazy"
                  />
                </div>
                <div class="frame reveal aspect-[4/3]" data-delay="90">
                  <Image
                    src={images.sub}
                    alt={images.altSub}
                    widths={[600, 900, 1400]}
                    sizes="(min-width: 1024px) 46vw, 92vw"
                    class="img-cover"
                    loading="lazy"
                  />
                </div>
              </div>

              <div class={flip ? 'lg:order-1' : ''}>
                <span class="ordinal reveal">{service.ordinal}</span>
                <h2 class="display-lg reveal mt-4" data-delay="60">
                  {service.name}
                </h2>
                <p class="reveal mt-3 text-lg font-medium text-ember-soft" data-delay="90">
                  {service.short}
                </p>
                <p class="prose-pf reveal mt-6" data-delay="120">
                  {service.summary}
                </p>

                <ul class="mt-10 flex flex-col gap-8">
                  {service.points.map((point, i) => (
                    <li class="reveal border-l border-hair pl-6" data-delay={i * 70}>
                      <h3 class="display-sm">{point.title}</h3>
                      <p class="mt-3 text-[0.9375rem] leading-relaxed text-mist">{point.body}</p>
                    </li>
                  ))}
                </ul>

                <div class="card reveal mt-10 p-7">
                  <h3 class="text-[0.6875rem] font-semibold uppercase tracking-[0.16em] text-dim">
                    Cụ thể là thế nào
                  </h3>
                  <ul class="mt-5 flex flex-col gap-3">
                    {service.detail.map((line) => (
                      <li class="flex gap-3 text-[0.9375rem] text-mist">
                        <Icon name="check" size={17} class="mt-1 shrink-0 text-ember" />
                        <span>{line}</span>
                      </li>
                    ))}
                  </ul>
                  <hr class="rule my-6" />
                  <p class="text-[0.9375rem] text-mist">{service.forWho}</p>
                </div>

                <div class="reveal mt-8 flex flex-col gap-3 sm:flex-row">
                  <a href="/lien-he" class="btn btn-primary">
                    Hỏi về {service.name.toLowerCase()}
                    <Icon name="arrowRight" size={17} />
                  </a>
                  <a href="/ve-chung-toi#huan-luyen-vien" class="btn btn-ghost">
                    Xem huấn luyện viên
                  </a>
                </div>
              </div>
            </div>
          </div>
        </section>
      );
    })
  }

  <!-- ============ BUOI DAU TIEN ============ -->
  <section class="section border-t border-hair">
    <div class="shell">
      <SectionHeading
        eyebrow="Chung cho cả hai"
        title="Buổi đầu tiên luôn diễn ra theo bốn bước này"
        lede="Dù bạn chọn tập nhóm hay PT 1 kèm 1 thì lần đầu tới cũng giống nhau."
      />

      <ol class="mt-14 grid gap-px overflow-hidden border border-hair bg-hair sm:grid-cols-2 lg:grid-cols-4">
        {
          FIRST_VISIT.map((step, index) => (
            <li class="reveal bg-ink p-7" data-delay={index * 70}>
              <span class="ordinal">{step.ordinal}</span>
              <h3 class="display-sm mt-4">{step.title}</h3>
              <p class="mt-4 text-[0.9375rem] leading-relaxed text-mist">{step.body}</p>
            </li>
          ))
        }
      </ol>
    </div>
  </section>

  <CtaBand />
</Base>
