---
import Base from '../layouts/Base.astro';
import Icon from '../components/Icon.astro';
import PageHero from '../components/PageHero.astro';
import SectionHeading from '../components/SectionHeading.astro';
import Faq from '../components/Faq.astro';
import CtaBand from '../components/CtaBand.astro';
import { CONTACT, FACTS } from '../data/site.js';
import { SERVICES } from '../data/content.js';

import room04 from '../assets/room-04.jpg';

/**
 * GHI CHU CHO CHU PHONG TAP
 * Trang nay co tinh khong in con so, theo dung yeu cau.
 * Neu sau nay muon in bang gia that thi de xuat: giu nguyen bo cuc,
 * them mot dong gia vao moi the o phan "Ba thu quyet dinh con so".
 * Xem CONTENT-TODO.md.
 */

const factors = [
  {
    ordinal: '01',
    title: 'Bạn tập nhóm hay tập riêng',
    body: 'Lớp nhóm chia chi phí huấn luyện viên cho cả nhóm nên nhẹ hơn. PT 1 kèm 1 là một người kèm riêng bạn suốt buổi nên cao hơn. Nhiều hội viên tập nhóm là chính rồi thêm vài buổi riêng khi cần sửa kỹ thuật.',
  },
  {
    ordinal: '02',
    title: 'Một tuần bạn tập mấy buổi',
    body: 'Hai buổi một tuần đã đủ để thấy khác trong người. Ba tới bốn buổi thì nhanh hơn. Chúng tôi không khuyên bạn mua nhiều hơn mức bạn đi được, vì mua rồi bỏ đó là chuyện chúng tôi muốn tránh nhất.',
  },
  {
    ordinal: '03',
    title: 'Bạn đi trong bao lâu',
    body: 'Gói dài thì đơn giá mỗi buổi rẻ hơn, đó là chuyện thường. Nhưng nếu bạn mới quay lại tập sau nhiều năm, chúng tôi sẽ nói bạn bắt đầu bằng gói ngắn trước.',
  },
];

const included = [
  'Huấn luyện viên có mặt trên sàn suốt buổi tập của bạn',
  `Một buổi ${FACTS.sessionLength}, tính cả khởi động và giãn cơ`,
  'Bài tập được chỉnh theo sức bạn hôm đó, không theo giáo án cứng',
  'Buổi đầu có người dẫn bạn đi một vòng và chỉ chỗ mọi thứ',
  'Chỗ thay đồ, chỗ gửi đồ và nước uống',
  CONTACT.parking,
];

const promises = [
  {
    title: 'Không có gói nào phải giải mã',
    body: 'Bạn hỏi giá, chúng tôi trả lời bằng một con số và những gì đi kèm con số đó. Hết.',
  },
  {
    title: 'Không ai chốt sale ép bạn',
    body: 'Xem xong buổi đầu bạn cứ về nghĩ. Không có ai gọi lại ba lần một ngày, không có giá chỉ hôm nay.',
  },
  {
    title: 'Không mua trước rồi mới được xem',
    body: 'Bạn được vào xem phòng, gặp huấn luyện viên và thử vài động tác trước khi bàn tới chuyện tiền.',
  },
];

const priceFaq = [
  {
    q: 'Sao trang này không ghi luôn con số?',
    a: 'Vì con số chỉ đúng khi biết bạn tập nhóm hay tập riêng, một tuần mấy buổi và đi trong bao lâu. Ghi một mức chung lên đây thì hoặc là sai với bạn, hoặc là phải kèm một rừng chú thích. Chúng tôi chọn cách nhắn cho bạn con số đúng với trường hợp của bạn, thường là trong ngày.',
  },
  {
    q: 'Mức giá của chúng tôi nằm ở đâu so với chỗ khác?',
    a: 'Tầm trung. Không phải chỗ rẻ nhất khu này, cũng không phải chỗ đắt nhất. Bạn trả cho phần huấn luyện viên đứng cạnh bạn, đó là phần các phòng tập tự tập không có.',
  },
  {
    q: 'Có phải đóng trước cả năm không?',
    a: 'Không. Nếu bạn lâu rồi chưa tập lại, chúng tôi còn khuyên bạn bắt đầu bằng gói ngắn để xem có đi đều được không đã.',
  },
  {
    q: 'Hỏi giá thì bao lâu có trả lời?',
    a: `Bạn nhắn Zalo hoặc gọi ${CONTACT.phoneDisplay}, thường là có người trả lời trong ngày. Nhắn ngoài giờ mở cửa thì sáng hôm sau sẽ có phản hồi.`,
  },
];
---

<Base
  title="Bảng giá"
  description="Panther Fit nói thẳng con số khi bạn hỏi, không có gói nào phải giải mã. Giá tuỳ vào việc bạn tập nhóm hay PT 1 kèm 1, một tuần mấy buổi và đi trong bao lâu."
>
  <PageHero
    eyebrow="Bảng giá"
    title="Chúng tôi nói thẳng con số, chỉ là nói riêng với bạn"
    lede="Không có gói nào phải ngồi giải mã, không có phí nào giấu ở cuối trang. Nhắn một câu là chúng tôi báo giá đúng với cách tập của bạn, thường là trong ngày."
    image={room04}
    alt="Khu vực tập tạ của phòng tập Panther Fit"
  />

  <!-- ============ BA THU QUYET DINH GIA ============ -->
  <section class="section">
    <div class="shell">
      <SectionHeading
        eyebrow="Cách tính"
        title="Ba thứ quyết định con số của bạn"
        lede="Biết ba thứ này là chúng tôi báo được giá ngay, không cần bạn tới tận nơi."
      />

      <div class="mt-14 grid gap-px overflow-hidden border border-hair bg-hair lg:grid-cols-3">
        {
          factors.map((factor, index) => (
            <div class="reveal bg-ink p-8 lg:p-10" data-delay={index * 80}>
              <span class="ordinal">{factor.ordinal}</span>
              <h3 class="display-sm mt-4">{factor.title}</h3>
              <p class="mt-5 text-[0.9375rem] leading-relaxed text-mist">{factor.body}</p>
            </div>
          ))
        }
      </div>

      <div class="mt-8 grid gap-6 sm:grid-cols-2">
        {
          SERVICES.map((service, index) => (
            <a
              href={`/dich-vu#${service.slug}`}
              class="card card-hover reveal flex items-center justify-between gap-6 p-7"
              data-delay={index * 80}
            >
              <div>
                <h3 class="display-sm">{service.name}</h3>
                <p class="mt-1.5 text-[0.9375rem] text-mist">{service.short}</p>
              </div>
              <Icon name="arrowUpRight" size={20} class="shrink-0 text-ember" />
            </a>
          ))
        }
      </div>
    </div>
  </section>

  <!-- ============ TRONG GOI NAO CUNG CO ============ -->
  <section class="section border-t border-hair bg-night">
    <div class="shell">
      <div class="grid gap-12 lg:grid-cols-2 lg:gap-20">
        <div>
          <SectionHeading eyebrow="Đi kèm" title="Gói nào cũng có sẵn những thứ này" />
          <ul class="mt-9 flex flex-col gap-4">
            {
              included.map((item, index) => (
                <li class="reveal flex gap-3.5 text-[0.9375rem] text-mist" data-delay={index * 50}>
                  <Icon name="check" size={18} class="mt-0.5 shrink-0 text-ember" />
                  <span>{item}</span>
                </li>
              ))
            }
          </ul>
        </div>

        <div>
          <SectionHeading eyebrow="Cam kết" title="Và những thứ chúng tôi không làm" />
          <div class="mt-9 flex flex-col gap-px overflow-hidden border border-hair bg-hair">
            {
              promises.map((promise, index) => (
                <div class="reveal bg-night p-7" data-delay={index * 70}>
                  <h3 class="display-sm">{promise.title}</h3>
                  <p class="mt-3 text-[0.9375rem] leading-relaxed text-mist">{promise.body}</p>
                </div>
              ))
            }
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- ============ HOI DAP VE GIA ============ -->
  <section class="section">
    <div class="shell">
      <div class="grid gap-12 lg:grid-cols-[0.8fr_1.2fr] lg:gap-20">
        <SectionHeading eyebrow="Hỏi đáp" title="Mấy câu hay gặp về tiền nong" />
        <Faq items={priceFaq} />
      </div>
    </div>
  </section>

  <CtaBand
    title="Hỏi giá thì cứ hỏi thẳng"
    body="Bạn cho chúng tôi biết bạn muốn tập nhóm hay tập riêng, một tuần đi được mấy buổi. Chúng tôi báo lại con số cụ thể, không vòng vo."
  />
</Base>
