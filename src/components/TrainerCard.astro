---
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';

interface Props {
  trainer: {
    name: string;
    role: string;
    image: ImageMetadata;
    alt: string;
    focus: string[];
    bio: string;
  };
  index?: number;
}

const { trainer, index = 0 } = Astro.props;
---

<article class="card card-hover reveal overflow-hidden" data-delay={(index % 3) * 70}>
  <div class="frame frame-zoom aspect-[4/5]">
    <Image
      src={trainer.image}
      alt={trainer.alt}
      widths={[420, 640, 900]}
      sizes="(min-width: 1024px) 30vw, (min-width: 640px) 45vw, 90vw"
      class="img-cover"
      loading="lazy"
    />
    <div
      class="pointer-events-none absolute inset-x-0 bottom-0 h-1/3 bg-gradient-to-t from-carbon to-transparent"
    >
    </div>
  </div>

  <div class="p-6">
    <h3 class="display-sm">{trainer.name}</h3>
    <p class="mt-1.5 text-sm font-medium text-ember-soft">{trainer.role}</p>
    <p class="mt-4 text-[0.9375rem] leading-relaxed text-mist">{trainer.bio}</p>

    <ul class="mt-5 flex flex-wrap gap-2">
      {
        trainer.focus.map((tag) => (
          <li class="rounded-sm border border-hair px-2.5 py-1 text-xs font-medium text-dim">
            {tag}
          </li>
        ))
      }
    </ul>
  </div>
</article>
