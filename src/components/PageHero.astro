---
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';

interface Props {
  eyebrow: string;
  title: string;
  lede?: string;
  image: ImageMetadata;
  alt: string;
  /**
   * Phan nao cua anh duoc giu lai khi cat cho vua khung.
   * Mac dinh giu phan tren de khong cat mat mat nguoi trong anh.
   * Dat lai neu anh nao co bo cuc khac, vi du 'center' hoac 'center 60%'.
   */
  focus?: string;
  /**
   * Do dam cua lop phu tren anh.
   * 'light' lam nua phai sang hon han de nhin ro nguoi trong anh,
   * bu lai bang cach lam dam dai ben trai la cho dat chu.
   */
  scrim?: 'normal' | 'light';
}

const { eyebrow, title, lede, image, alt, focus = 'center 22%', scrim = 'normal' } = Astro.props;

/**
 * Ba lop phu, do bang mo hinh tinh tuong phan tren tung diem anh.
 * Ca hai muc deu giu chu trong nguong doc duoc, chi khac o cho
 * 'light' don phan lam toi vao dai trai thay vi trai deu ca anh.
 */
const LOP_PHU = {
  normal: { nen: 'bg-ink/42', doc: 'from-ink/80 via-ink/42 to-ink/12', ngang: 'from-ink/92 via-ink/62 to-transparent' },
  light: { nen: 'bg-ink/22', doc: 'from-ink/70 via-ink/28 to-ink/[0.04]', ngang: 'from-ink/[0.96] via-ink/78 to-transparent' },
}[scrim];
---

<section class="relative overflow-hidden bg-night pt-[4.5rem] lg:pt-20">
  <div class="absolute inset-0">
    <Image
      src={image}
      alt={alt}
      widths={[900, 1400, 2200]}
      sizes="100vw"
      class="img-cover"
      style={`object-position: ${focus}`}
      loading="eager"
      fetchpriority="high"
    />
    <div class:list={['absolute inset-0', LOP_PHU.nen]}></div>
    <div class:list={['absolute inset-0 bg-gradient-to-t', LOP_PHU.doc]} aria-hidden="true"></div>
    <div class:list={['absolute inset-0 bg-gradient-to-r', LOP_PHU.ngang]} aria-hidden="true"></div>
  </div>

  <div class="shell relative">
    <div class="max-w-3xl py-24 md:py-32 lg:py-40">
      <p class="eyebrow reveal">{eyebrow}</p>
      <h1 class="display-lg reveal mt-5" data-delay="60">{title}</h1>
      {lede && <p class="lede reveal mt-6 max-w-2xl" data-delay="120">{lede}</p>}
    </div>
  </div>
</section>
