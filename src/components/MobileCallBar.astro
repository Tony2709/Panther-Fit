---
import Icon from './Icon.astro';
import { CONTACT } from '../data/site.js';

/**
 * Thanh goi nhanh o day man hinh dien thoai.
 * Khach tim phong tap tren dien thoai thuong bam goi hoac nhan tin
 * ngay chu it khi dien form, nen de hai nut nay luon trong tam tay.
 */
---

<div
  class="fixed inset-x-0 bottom-0 z-40 border-t border-hair bg-night/95 backdrop-blur-md lg:hidden"
  style="padding-bottom: env(safe-area-inset-bottom, 0px)"
>
  <div class="grid grid-cols-2 gap-2 p-3">
    <a href={`tel:${CONTACT.phoneRaw}`} class="btn btn-ghost w-full">
      <Icon name="phone" size={17} />
      Gọi
    </a>
    <a
      href={CONTACT.zalo}
      target="_blank"
      rel="noopener noreferrer"
      class="btn btn-primary w-full"
    >
      <Icon name="message" size={17} />
      Nhắn tin
    </a>
  </div>
</div>

<!-- Chua cho thanh nut khoi che mat noi dung cuoi trang -->
<div class="h-[4.75rem] lg:hidden" aria-hidden="true"></div>
